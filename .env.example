DEMO_MODE=true
LIVE_LLM_ENABLED=false
ANALYSIS_MODE=evidence_only
# Only for an explicitly authorized live run; never commit a real key.
LLM_API_KEY=
LLM_RUNTIME_FILE=config/llm-runtime.json
LLM_TARIFF_FILE=config/llm-tariffs.json
# Operator acceptance applies to the shared gateway and all allowlisted models.
# It does not itself authorize spending. Safe default for new installations: false.
LLM_BILLABLE_OUTPUT_CAP_CONFIRMED=false
# Explicit durable authorization; created/closed with scripts.live_session, never on startup.
# May accept unconfirmed cap/price risk without asserting the flag above is true.
LLM_LIVE_SESSION_ID=
APP_CODE_SHA=unknown
# Select one allowed address explicitly. Never automatic failover after uncertainty.
LLM_BASE_URL=https://changellenge.up.railway.app/v1
APP_SECRET=
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
DATABASE_URL=postgresql+asyncpg://alfa:alfa_local@db:5432/alfa
APP_PORT=8000
